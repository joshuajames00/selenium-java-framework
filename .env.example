# Example environment configuration
# Copy this file to .env for local overrides (never commit .env)
#
# These values can also be passed directly as Maven system properties:
#   mvn test -Dbrowser=firefox -Dheadless=true -DbaseUrl=https://the-internet.herokuapp.com/

BROWSER=chrome
BASE_URL=https://the-internet.herokuapp.com/
EXPLICIT_WAIT=10
HEADLESS=false
ENVIRONMENT=demo
